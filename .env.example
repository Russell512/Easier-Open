# Optional cloud credentials; unconfigured npm run dev uses local demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set true to force local mode; cloud deployments require false.
# build:local explicitly enables local mode.
VITE_LOCAL_MODE=false
# Enable signup only after testing custom SMTP and Email confirmations.
# Existing Email accounts can still sign in when this is false.
VITE_EMAIL_SIGNUP_ENABLED=false
# Apple OAuth requires Apple Developer Program resources and Supabase setup.
# Never put an Apple client secret or .p8 key in VITE_* variables.
# See docs/apple-sign-in.md.
