{
  "name": "easier-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:documents": "node scripts/check-documents.mjs",
    "test:tabs": "node scripts/check-workspace-tabs.mjs",
    "test:notes": "node scripts/check-program-notes.mjs && node scripts/check-note-markdown.mjs",
    "test:program-import": "node scripts/check-program-import.mjs",
    "test:auth": "node scripts/check-oauth-auth.mjs",
    "test:autosync": "node scripts/check-autosync.mjs",
    "build:cloud": "node scripts/verify-cloud-config.mjs && npm run build && node scripts/prepare-cloud-build.mjs",
    "build:local": "node scripts/build-local.mjs",
    "test:shortlist": "node scripts/check-shortlist-export.mjs",
    "test:sharing": "node scripts/check-sharing.mjs",
    "test:demo": "node scripts/check-demo.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "markdown-it-mark": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "license": "MIT",
  "description": "Open-source program shortlisting, notes and application workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/Russell512/Easier-Open.git"
  }
}
